#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt { flavor = "tap-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <3 4>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <15 16>;
        };

        tmux {
            bindings = <&kp RC(B)>;
            key-positions = <7 8>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20>;
        };
    };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp LS(DOT)>;
            label = "ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "base";
            bindings = <
&trans  &lt 3 Q  &kp W  &kp F     &kp P      &mt LCTRL B             &mt RCTRL J                &kp L     &kp U      &kp Y    &lt 3 SEMI  &trans
&trans  &kp A    &kp R  &lt 2 S   &lt 1 T    &mt LEFT_GUI G          &mt RIGHT_GUI M            &lt 1 N   &lt 2 E    &kp I    &kp O       &trans
&trans  &kp Z    &kp X  &kp C     &kp D      &mt LEFT_ALT V          &mt RIGHT_ALT K            &kp H     &kp COMMA  &kp DOT  &kp FSLH    &trans
                        &kp LEFT  &kp RIGHT  &mt LEFT_SHIFT SPACE    &mt RIGHT_SHIFT BACKSPACE  &kp DOWN  &kp UP
            >;
        };

        sym {
            label = "sym";
            bindings = <
&trans  &trans     &trans      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOUBLE_QUOTES    &trans  &kp BACKSLASH     &trans     &trans  &trans  &trans
&trans  &kp CARET  &kp DOLLAR  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SINGLE_QUOTE     &arrow  &kp MINUS     &trans     &trans  &trans  &trans
&trans  &trans     &trans      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GRAVE            &trans  &kp EQUAL     &trans     &trans  &trans  &trans
                               &kp LESS_THAN         &kp GREATER_THAN       &kp TILDE            &kp DEL &kp PG_DN  &kp PG_UP
            >;
        };

        fn {
            label = "fn";
            bindings = <
&trans  &kp F10  &kp F9  &kp F8  &kp F7  &trans    &trans  &kp N7  &kp N8  &kp N9  &kp PLUS   &trans
&trans  &kp F11  &kp F6  &kp F5  &kp F4  &trans    &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &kp F12  &kp F3  &kp F2  &kp F1  &trans    &trans  &kp N1  &kp N2  &kp N3  &trans     &trans
                         &trans  &trans  &trans    &trans  &kp N0  &trans
            >;
        };

        ops {
            label = "ops";
            bindings = <
&trans  &bt BT_CLR  &trans        &trans        &trans        &bt BT_CLR_ALL    &soft_off  &trans  &trans  &trans  &kp C_MUTE         &trans
&trans  &trans      &trans        &bt BT_SEL 4  &bt BT_SEL 3  &trans            &trans  &trans  &trans  &trans  &kp C_VOLUME_UP    &trans
&trans  &trans      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans            &trans  &trans  &trans  &trans  &kp C_VOLUME_DOWN  &trans
                                  &bt BT_PRV    &bt BT_NXT    &out OUT_TOG      &trans  &trans  &trans
            >;
        };
    };
};

