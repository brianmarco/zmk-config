#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        tmux_leader {
            bindings = <&kp LC(B)>;
            key-positions = <16 19>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <16 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "base";
            bindings = <
&kp TAB     &kp Q  &kp W  &kp F     &kp P      &mt LCTRL B       &mt RCTRL J      &kp L     &kp U      &kp Y    &lt 3 SEMI  &kp BACKSLASH
&trans  &kp A  &kp R  &lt 2 S   &lt 1 T    &mt LEFT_GUI G    &mt RIGHT_GUI M  &lt 1 N   &lt 2 E    &kp I    &kp O       &kp ENTER
&kp EQUAL   &kp Z  &kp X  &kp C     &kp D      &mt LEFT_ALT V    &mt RIGHT_ALT K  &kp H     &kp COMMA  &kp DOT  &kp FSLH    &kp MINUS
                          &kp LEFT  &kp RIGHT  &kp SPACE         &kp BACKSPACE    &kp DOWN  &kp UP
            >;
        };

        sym {
            label = "sym";
            bindings = <
&trans  &trans      &trans      &kp LEFT_BRACE      &kp RIGHT_BRACE      &kp LS(SINGLE_QUOTE)    &trans   &trans  &trans  &trans  &kp K_MUTE        &trans
&trans  &kp LS(N6)  &kp LS(N4)  &kp LS(N9)          &kp LS(N0)           &kp SINGLE_QUOTE        &trans   &trans  &trans  &trans  &kp K_VOLUME_UP   &trans
&trans  &trans      &trans      &kp LS(LEFT_BRACE)  &kp LS(RIGHT_BRACE)  &kp GRAVE               &trans   &trans  &trans  &trans  &kp K_VOLUME_DOWN &trans
                                &kp LS(COMMA)       &kp LS(PERIOD)       &kp LS(GRAVE)           &kp DEL  &kp PG_DN       &kp PG_UP
            >;
        };

        fn {
            label = "fn";
            bindings = <
&trans  &kp F10  &kp F9  &kp F8  &kp F7  &trans    &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &kp F11  &kp F6  &kp F5  &kp F4  &trans    &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &kp F12  &kp F3  &kp F2  &kp F1  &trans    &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
                         &trans  &trans  &trans    &trans  &kp N0  &trans
            >;
        };

        ops {
            label = "ops";
            bindings = <
&bt BT_CLR  &trans  &trans        &trans        &trans        &bt BT_CLR_ALL    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans        &bt BT_SEL 4  &bt BT_SEL 3  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans            &trans  &trans  &trans  &trans  &trans  &trans
                                  &bt BT_PRV    &bt BT_NXT    &trans            &trans  &trans  &trans
            >;
        };
    };
};

