#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt { 
  flavor = "tap-preferred"; 
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <3 4>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <15 16>;
        };

        tmux {
            bindings = <&kp RC(B)>;
            key-positions = <7 8>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <27 28>;
        };

        mins {
            bindings = <&kp MINUS>;
            key-positions = <31 32>;
        };
    };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp LS(DOT)>;
            label = "ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "base";
            bindings = <
//    ┌─────┬────────┬───┬────────┬────────┬─────────────┐   ┌──────────────┬────────┬────────┬───┬────────┬─────┐
//    │     │ lt 3 Q │ W │   F    │   P    │  mt lctl B  │   │  mt rctl J   │   L    │   U    │ Y │ lt 3 ; │     │
//    ├─────┼────────┼───┼────────┼────────┼─────────────┤   ├──────────────┼────────┼────────┼───┼────────┼─────┤
//    │     │   A    │ R │ lt 2 S │ lt 1 T │  mt lgui G  │   │  mt rgui M   │ lt 1 N │ lt 2 E │ I │   O    │     │
//    ├─────┼────────┼───┼────────┼────────┼─────────────┤   ├──────────────┼────────┼────────┼───┼────────┼─────┤
//    │     │   Z    │ X │   C    │   D    │  mt lalt V  │   │  mt ralt K   │   H    │   ,    │ . │   /    │     │
//    └─────┴────────┴───┼────────┼────────┼─────────────┤   ├──────────────┼────────┼────────┼───┴────────┴─────┘
//                       │  left  │  rght  │ mt lsft spc │   │ mt rsft bspc │  down  │   up   │
//                       └────────┴────────┴─────────────┘   └──────────────┴────────┴────────┘
  &trans   &lt 3 Q   &kp W   &kp F      &kp P       &mt LCTRL B                &mt RCTRL J                 &kp L      &kp U       &kp Y     &lt 3 SEMI   &trans
  &trans   &kp A     &kp R   &lt 2 S    &lt 1 T     &mt LEFT_GUI G             &mt RIGHT_GUI M             &lt 1 N    &lt 2 E     &kp I     &kp O        &trans
  &trans   &kp Z     &kp X   &kp C      &kp D       &mt LEFT_ALT V             &mt RIGHT_ALT K             &kp H      &kp COMMA   &kp DOT   &kp FSLH     &trans
                             &kp LEFT   &kp RIGHT   &mt LEFT_SHIFT SPACE       &mt RIGHT_SHIFT BACKSPACE   &kp DOWN   &kp UP
            >;
        };

        sym {
            label = "sym";
            bindings = <
//    ┌─────┬─────┬─────┬───┬───┬───┐   ┌─────────┬──────┬────────────────┬────────────────┬────────────────┬─────┐
//    │     │     │     │ { │ } │ " │   │         │  \   │      lclk      │  &mmv MOVE_up  │      rclk      │     │
//    ├─────┼─────┼─────┼───┼───┼───┤   ├─────────┼──────┼────────────────┼────────────────┼────────────────┼─────┤
//    │     │  ^  │  $  │ ( │ ) │ ' │   │ &arrow  │  -   │ &mmv MOVE_left │ &mmv MOVE_down │ &mmv MOVE_rght │     │
//    ├─────┼─────┼─────┼───┼───┼───┤   ├─────────┼──────┼────────────────┼────────────────┼────────────────┼─────┤
//    │     │     │     │ [ │ ] │ ` │   │ lsft(\) │  =   │                │                │                │     │
//    └─────┴─────┴─────┼───┼───┼───┤   ├─────────┼──────┼────────────────┼────────────────┴────────────────┴─────┘
//                      │ < │ > │ ~ │   │   del   │ pgdn │      pgup      │
//                      └───┴───┴───┘   └─────────┴──────┴────────────────┘
  &trans   &trans      &trans       &kp LEFT_BRACE         &kp RIGHT_BRACE         &kp DOUBLE_QUOTES       &trans              &kp BACKSLASH   &mkp LCLK        &mmv MOVE_UP     &mkp RCLK         &trans
  &trans   &kp CARET   &kp DOLLAR   &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS   &kp SINGLE_QUOTE        &arrow              &kp MINUS       &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT   &trans
  &trans   &trans      &trans       &kp LEFT_BRACKET       &kp RIGHT_BRACKET       &kp GRAVE               &kp LS(BACKSLASH)   &kp EQUAL       &trans           &trans           &trans            &trans
                                    &kp LESS_THAN          &kp GREATER_THAN        &kp TILDE               &kp DEL             &kp PG_DN       &kp PG_UP
            >;
        };

        fn {
            label = "num";
            bindings = <
//    ┌─────┬─────┬────┬─────┬─────┬─────┐   ┌─────┬───┬─────┬───┬─────┬─────┐
//    │     │ f10 │ f9 │ f8  │ f7  │     │   │     │ 7 │  8  │ 9 │  +  │     │
//    ├─────┼─────┼────┼─────┼─────┼─────┤   ├─────┼───┼─────┼───┼─────┼─────┤
//    │     │ f11 │ f6 │ f5  │ f4  │     │   │     │ 4 │  5  │ 6 │  -  │     │
//    ├─────┼─────┼────┼─────┼─────┼─────┤   ├─────┼───┼─────┼───┼─────┼─────┤
//    │     │ f12 │ f3 │ f2  │ f1  │     │   │     │ 1 │  2  │ 3 │     │     │
//    └─────┴─────┴────┼─────┼─────┼─────┤   ├─────┼───┼─────┼───┴─────┴─────┘
//                     │     │     │     │   │     │ 0 │     │
//                     └─────┴─────┴─────┘   └─────┴───┴─────┘
  &trans   &kp F10   &kp F9   &kp F8   &kp F7   &trans       &trans   &kp N7   &kp N8   &kp N9   &kp PLUS    &trans
  &trans   &kp F11   &kp F6   &kp F5   &kp F4   &trans       &trans   &kp N4   &kp N5   &kp N6   &kp MINUS   &trans
  &trans   &kp F12   &kp F3   &kp F2   &kp F1   &trans       &trans   &kp N1   &kp N2   &kp N3   &trans      &trans
                              &trans   &trans   &trans       &trans   &kp N0   &trans
            >;
        };

        ops {
            label = "ops";
            bindings = <
//    ┌─────┬────────────┬──────────┬──────────┬──────────┬───────────┐   ┌───────────────┬─────┬─────┬─────┬──────┬─────┐
//    │     │   bt_clr   │          │          │          │ &soft_off │   │   &soft_off   │     │     │     │ mute │     │
//    ├─────┼────────────┼──────────┼──────────┼──────────┼───────────┤   ├───────────────┼─────┼─────┼─────┼──────┼─────┤
//    │     │ bt_clr_ALL │          │ bt_sel 4 │ bt_sel 3 │           │   │               │     │     │     │ volu │     │
//    ├─────┼────────────┼──────────┼──────────┼──────────┼───────────┤   ├───────────────┼─────┼─────┼─────┼──────┼─────┤
//    │     │            │ bt_sel 2 │ bt_sel 1 │ bt_sel 0 │           │   │               │     │     │     │ vold │     │
//    └─────┴────────────┴──────────┼──────────┼──────────┼───────────┤   ├───────────────┼─────┼─────┼─────┴──────┴─────┘
//                                  │  bt_prv  │  bt_nxt  │ out_ tog  │   │ lsft(lgui(4)) │     │     │
//                                  └──────────┴──────────┴───────────┘   └───────────────┴─────┴─────┘
  &trans   &bt BT_CLR       &trans         &trans         &trans         &soft_off          &soft_off        &trans   &trans   &trans   &kp C_MUTE          &trans
  &trans   &bt BT_CLR_ALL   &trans         &bt BT_SEL 4   &bt BT_SEL 3   &trans             &trans           &trans   &trans   &trans   &kp C_VOLUME_UP     &trans
  &trans   &trans           &bt BT_SEL 2   &bt BT_SEL 1   &bt BT_SEL 0   &trans             &trans           &trans   &trans   &trans   &kp C_VOLUME_DOWN   &trans
                                           &bt BT_PRV     &bt BT_NXT     &out OUT_TOG       &kp LS(LG(N4))   &trans   &trans
            >;
        };
    };
};

